@prefix woc:     <http://rdf.webofcode.org/woc/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xkos:    <http://rdf-vocabulary.ddialliance.org/xkos#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

woc:hasInitializer  rdf:type   owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasInitializer property relates a variable declaration to the expression assigned to the declared variable"@en;
        rdfs:domain         woc:VariableDeclarationStatement;
        rdfs:label          "has initializer"@en;
        rdfs:range          woc:Expression;
        rdfs:subPropertyOf  woc:hasSubExpression;
        owl:inverseOf       woc:isInitializerOf .

woc:isModifierOf  rdf:type  owl:ObjectProperty;
        rdfs:comment  "The isModifierOf property relates a modifier to the corresponding modifiable element."@en;
        rdfs:domain   woc:Modifier;
        rdfs:label    "is modifier of"@en;
        rdfs:range    woc:Modifiable .

woc:hasResource  rdf:type  owl:ObjectProperty;
        rdfs:comment  "The hasResource property relates a try statement to each local variable declared to act as resource for the try statement"@en;
        rdfs:domain   woc:TryStatement;
        rdfs:label    "has resource"@en;
        rdfs:range    woc:LocalVariable .

woc:ExpressionStatement  rdf:type  owl:Class;
        rdfs:comment     "An expression statement. that is a statement that wraps an expression"@en;
        rdfs:label       "Expression statement"@en;
        rdfs:subClassOf  woc:Statement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasSubExpression;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:BreakStatement  rdf:type  owl:Class;
        rdfs:comment     "The BreakStatement class represents a break statement. The break statement has two forms: labeled and unlabeled. In case a break statement is labeled, the label is defined through the targetedLabel property"@en;
        rdfs:label       "Break Statement"@en;
        rdfs:subClassOf  woc:BranchingStatement .

woc:isThrownExpressionOf
        rdf:type            owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isThrownExpressionOf property relates a thrown expression, to the throw statement it is contained in."@en;
        rdfs:domain         woc:Expression;
        rdfs:label          "is thrown expression of"@en;
        rdfs:range          woc:ThrowStatement;
        rdfs:subPropertyOf  woc:isSubExpressionOf .

woc:hasCatchFormalParameter
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "The hasCatchFormalParameter property relates a catch clause to its formal parameters, namely the throwable objects it caughts"@en;
        rdfs:domain   woc:CatchBlock;
        rdfs:label    "has catch formal parameter"@en;
        rdfs:range    woc:Class .

woc:hasNextStatement  rdf:type  owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasNextStatement property relates a statement to the next statement to be executed."@en;
        rdfs:domain         woc:Statement;
        rdfs:label          "next"@en;
        rdfs:range          woc:Statement;
        rdfs:subPropertyOf  xkos:next;
        owl:inverseOf       woc:hasPreviousStatement .

woc:Final  rdf:type      woc:Modifier , owl:NamedIndividual;
        rdfs:comment  "The final modifier"@en;
        rdfs:label    "Final"@en .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( woc:CodeElement woc:Library woc:Project )
] .

woc:LabeledBlock  rdf:type  owl:Class;
        rdfs:comment     "A labeled block of code, namely a case-labeled block or a default-labeled block"@en;
        rdfs:label       "Labeled Block"@en;
        rdfs:subClassOf  woc:BlockStatement;
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  woc:LabeledBlock;
                           owl:onProperty     woc:hasNextStatement
                         ] .

woc:hasLeftHandSide  rdf:type  owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasLeftHandSide property relates a assignement expression to the left hand side expression it contains"@en;
        rdfs:domain         woc:AssignmentExpression;
        rdfs:label          "has left hand side"@en;
        rdfs:range          woc:Expression;
        rdfs:subPropertyOf  woc:hasSubExpression;
        owl:inverseOf       woc:isLeftHandSideOf .

woc:Type   rdf:type         owl:Class;
        rdfs:comment     "A type"@en;
        rdfs:label       "Type"@en;
        rdfs:subClassOf  woc:CodeElement .

woc:Library  rdf:type       owl:Class;
        rdfs:comment     "A library"@en;
        rdfs:label       "Library"@en;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:string;
                           owl:onProperty            woc:hasName;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:invokes  rdf:type          owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The invokes property relates a invocation expression to the invoked executable."@en;
        rdfs:domain         woc:ExecutableInvocationExpression;
        rdfs:label          "invokes"@en;
        rdfs:range          woc:Executable;
        rdfs:subPropertyOf  owl:topObjectProperty .

xkos:generalizes  rdf:type  owl:ObjectProperty .

xkos:specializes  rdf:type  owl:ObjectProperty .

woc:isReturnedBy  rdf:type  owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment   "The isReturnedBy property relates a variable to the methods that return that variable."@en;
        rdfs:domain    woc:Variable;
        rdfs:label     "is returned by"@en;
        rdfs:range     woc:Method;
        owl:inverseOf  woc:returns .

woc:hasThenBranch  rdf:type    owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasThenBranch property relates a if-then-else statement to the statement declared in the \"then\" branch"@en;
        rdfs:domain         woc:IfThenElseStatement;
        rdfs:label          "has then branch"@en;
        rdfs:range          woc:Statement;
        rdfs:subPropertyOf  woc:hasSubStatement;
        owl:inverseOf       woc:isThenBranchOf .

woc:isBodyOf  rdf:type         owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isBodyOf property relates a block to the exexcutable or statement it is the body of."@en;
        rdfs:domain         woc:BlockStatement;
        rdfs:label          "is body of"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:Executable woc:LoopStatement woc:TryStatement )
                            ];
        rdfs:subPropertyOf  woc:isSubStatementOf .

woc:isLeftHandSideOf  rdf:type  owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isLeftHandSideOf property relates an expression that is used as left hand side expression of an assignemnt, to the corresponding assignment expression"@en;
        rdfs:domain         woc:Expression;
        rdfs:label          "is left hand side of"@en;
        rdfs:range          woc:AssignmentExpression;
        rdfs:subPropertyOf  woc:isSubExpressionOf .

woc:Default  rdf:type    woc:AccessModifier , owl:NamedIndividual;
        rdfs:comment  "The default modifier"@en;
        rdfs:label    "Default"@en .

woc:Enum   rdf:type         owl:Class;
        rdfs:comment     "An enumeration"@en;
        rdfs:label       "Enum"@en;
        rdfs:subClassOf  woc:ComplexType .

woc:isPackageOf  rdf:type      owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isPackageOf property relates a package to the types it declares."@en;
        rdfs:domain         woc:Package;
        rdfs:label          "is package of"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:AnnotationType woc:ComplexType )
                            ];
        rdfs:subPropertyOf  woc:declares .

woc:LocalVariableDeclarationStatement
        rdf:type         owl:Class;
        rdfs:comment     "A local variable declaration"@en;
        rdfs:label       "Local Variable Declaration Statement"@en;
        rdfs:subClassOf  woc:VariableDeclarationStatement .

woc:hasTarget  rdf:type        owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasTarget property relates a method invocation expression to its target."@en;
        rdfs:domain         woc:MethodInvocationExpression;
        rdfs:label          "has target"@en;
        rdfs:range          woc:Expression;
        rdfs:subPropertyOf  woc:hasSubExpression;
        owl:inverseOf       woc:isTargetOf .

woc:isInitializerOf  rdf:type  owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isInitializerOf property relates an expression used to initialize a variable, to the statement it is contained in."@en;
        rdfs:domain         woc:Expression;
        rdfs:label          "is initializer of"@en;
        rdfs:range          woc:VariableDeclarationStatement;
        rdfs:subPropertyOf  woc:isSubExpressionOf .

woc:hasConstructor  rdf:type   owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasConstructor property relates a class to its constructors."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:Class woc:Enum )
                            ];
        rdfs:label          "has constructor"@en;
        rdfs:range          woc:Constructor;
        rdfs:subPropertyOf  woc:declares;
        owl:inverseOf       woc:isConstructorOf .

woc:hasSimpleName  rdf:type    owl:DatatypeProperty;
        rdfs:comment        "Links a class, enum or interface to its simple name. For instance, the simple name of the class java.lang.String is \"String\""@en;
        rdfs:domain         woc:ComplexType;
        rdfs:label          "has simple name"@en;
        rdfs:range          xsd:string;
        rdfs:subPropertyOf  woc:hasName .

woc:hasThrownExpression  rdf:type  owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasThrownExpression property relates a thrown statement to the expression it throws"@en;
        rdfs:domain         woc:ThrowStatement;
        rdfs:label          "has thrown expression"@en;
        rdfs:range          woc:Expression;
        rdfs:subPropertyOf  woc:hasSubExpression;
        owl:inverseOf       woc:isThrownExpressionOf .

woc:hasCanonicalName  rdf:type  owl:DatatypeProperty;
        rdfs:comment        "Links a class, enum or interface to its canonical name. For instance, the class Java.lang.String is linked to the string \"java.lang.string\""@en;
        rdfs:domain         woc:ComplexType;
        rdfs:label          "has canonical name"@en;
        rdfs:range          xsd:string;
        rdfs:subPropertyOf  woc:hasName .

woc:AssignmentExpression
        rdf:type         owl:Class;
        rdfs:comment     "An assignment expression. It involves one of the following operators:\n=, *=, /=, %=, +=, -=, <<=, >>=, >>>=, &=, ^=, |="@en;
        rdfs:label       "Assignment Expression";
        rdfs:subClassOf  woc:Expression;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasSubExpression;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasLeftHandSide;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:Class  rdf:type         owl:Class;
        rdfs:comment     "A class"@en;
        rdfs:label       "Class"@en;
        rdfs:subClassOf  woc:ComplexType;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Class;
                           owl:onProperty            woc:extends;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  woc:Interface;
                           owl:onProperty     woc:implements
                         ];
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  woc:ClassDeclarationStatement;
                           owl:onProperty     woc:hasDeclaration
                         ];
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  woc:Class;
                           owl:onProperty     woc:extends
                         ] .

woc:TryStatement  rdf:type  owl:Class;
        rdfs:comment     "A try statement"@en;
        rdfs:label       "Try Statement"@en;
        rdfs:subClassOf  woc:Statement;
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  woc:BlockStatement;
                           owl:onProperty               woc:hasBody
                         ] .

woc:DecisionMakingStatement
        rdf:type         owl:Class;
        rdfs:comment     "A Decision Making Statement, that is a statement that break up the flow of execution by employing decision making. It can either be a if-then-else statement or a switch statement."@en;
        rdfs:label       "Decision Making Statement"@en;
        rdfs:subClassOf  woc:ControlFlowStatement .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( woc:ActualArgument woc:AssignmentExpression woc:ExecutableInvocationExpression )
] .

woc:DefaultLabeledBlock  rdf:type  owl:Class;
        rdfs:comment     "A default-labeled block"@en;
        rdfs:label       "Default Labeled Block"@en;
        rdfs:subClassOf  woc:LabeledBlock .

woc:isSubExpressionOf  rdf:type  owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isSubExpressionOf property relates an expression to its parent expression."@en;
        rdfs:domain         woc:Expression;
        rdfs:label          "is subexpression of"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:Expression woc:Statement )
                            ];
        rdfs:subPropertyOf  xkos:isPartOf .

woc:ReturnStatement  rdf:type  owl:Class;
        rdfs:comment     "A return statement"@en;
        rdfs:label       "Return Statement"@en;
        rdfs:subClassOf  woc:BranchingStatement .

woc:isImplementedBy  rdf:type  owl:ObjectProperty;
        rdfs:comment        "The isImplementedBy property relates an interface to the classes implementig that interface"@en;
        rdfs:domain         woc:Interface;
        rdfs:label          "is implemented by"@en;
        rdfs:range          woc:Class;
        rdfs:subPropertyOf  xkos:generalizes .

woc:Public  rdf:type     woc:AccessModifier , owl:NamedIndividual;
        rdfs:comment  "The public modifier"@en;
        rdfs:label    "Public"@en .

woc:BranchingStatement  rdf:type  owl:Class;
        rdfs:comment     "A branching statement, namely a break statement, a continue statement or a return statement"@en;
        rdfs:label       "Branching Statement"@en;
        rdfs:subClassOf  woc:ControlFlowStatement .

woc:Volatile  rdf:type   woc:Modifier , owl:NamedIndividual;
        rdfs:comment  "The volatile modifier"@en;
        rdfs:label    "Volatile"@en .

woc:hasModifier  rdf:type  owl:ObjectProperty;
        rdfs:comment   "The hasGenericType property relates a modifiable element to its modifiers"@en;
        rdfs:domain    woc:Modifiable;
        rdfs:label     "has modifier"@en;
        rdfs:range     woc:Modifier;
        owl:inverseOf  woc:isModifierOf .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( woc:DoStatement woc:ForEachStatement woc:ForStatement woc:WhileStatement )
] .

woc:hasAnnotation  rdf:type  owl:ObjectProperty;
        rdfs:comment   "The hasAnnotation property relates a code element to its annotations";
        rdfs:domain    woc:CodeElement;
        rdfs:label     "has annotation"@en;
        rdfs:range     woc:AnnotationType;
        owl:inverseOf  woc:isAnnotationOf .

woc:isThenBranchOf  rdf:type   owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isThenBranchOf property relates a statement enclosed in a then branch to the corresponding If-then-else statement"@en;
        rdfs:domain         woc:Statement;
        rdfs:label          "is then branch of"@en;
        rdfs:range          woc:IfThenElseStatement;
        rdfs:subPropertyOf  woc:isSubStatementOf .

woc:throws  rdf:type           owl:ObjectProperty;
        rdfs:comment        "The throws property relates a method or a constructor to the exceptions it declares to throw."@en;
        rdfs:domain         woc:Executable;
        rdfs:label          "throws"@en;
        rdfs:range          woc:Class;
        rdfs:subPropertyOf  woc:references .

woc:isParameterOf  rdf:type  owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment  "The isParameterOf property relates a parameter to the corresponding executable."@en;
        rdfs:domain   woc:Parameter;
        rdfs:label    "is parameter of"@en;
        rdfs:range    woc:Executable .

woc:hasType  rdf:type     owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment   "The hasType property relates an expression, a variable or a method to its type."@en;
        rdfs:domain    [ rdf:type     owl:Class;
                         owl:unionOf  ( woc:Expression woc:Method woc:Variable )
                       ];
        rdfs:label     "has type"@en;
        rdfs:range     woc:Type;
        owl:inverseOf  woc:isTypeOf .

woc:Method  rdf:type        owl:Class;
        rdfs:comment     "A Method"@en;
        rdfs:label       "Method"@en;
        rdfs:subClassOf  woc:Executable .

woc:isVarArgs  rdf:type  owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment  "True if an executable accepts a variable number of parameters, false otherwise"@en;
        rdfs:domain   woc:Executable;
        rdfs:label    "is var args"@en;
        rdfs:range    xsd:boolean .

woc:isCatchClauseOf  rdf:type  owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isCatchClauseOf property relates a catch clause to the corresponding try statement."@en;
        rdfs:domain         woc:CatchBlock;
        rdfs:label          "is catch clause of"@en;
        rdfs:range          woc:TryStatement;
        rdfs:subPropertyOf  woc:isSubStatementOf .

woc:SwitchStatement  rdf:type  owl:Class;
        rdfs:comment     "A switch statement"@en;
        rdfs:label       "Switch Statement"@en;
        rdfs:subClassOf  woc:DecisionMakingStatement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasSubExpression;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( woc:BranchingStatement woc:DecisionMakingStatement woc:LoopStatement )
] .

woc:Executable  rdf:type    owl:Class;
        rdfs:comment     "An executable block of code, namely a Method or a Constructor"@en;
        rdfs:label       "Executable"@en;
        rdfs:subClassOf  woc:Modifiable , woc:CodeElement;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      woc:isVarArgs;
                           owl:someValuesFrom  xsd:boolean
                         ] .

woc:hasBody  rdf:type          owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasBody property relates an executable or a statement to its body."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:Executable woc:LoopStatement woc:TryStatement )
                            ];
        rdfs:label          "has body"@en;
        rdfs:range          woc:BlockStatement;
        rdfs:subPropertyOf  woc:hasSubStatement;
        owl:inverseOf       woc:isBodyOf .

woc:isReturnedExpressionOf
        rdf:type            owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isReturnedExpressionOf property relates an expression returned by a method to the return statement it is contained in."@en;
        rdfs:domain         woc:Expression;
        rdfs:label          "is returned expression of"@en;
        rdfs:range          woc:ReturnStatement;
        rdfs:subPropertyOf  woc:isSubExpressionOf .

woc:SynchronizedStatement
        rdf:type         owl:Class;
        rdfs:comment     "A synchronized statement, that is a statement that acquires a mutual-exclusion lock on behalf of the executiing-thread, executes a block, then release the lock.\nIn java it is of the form:\nsynchronized <Expression> <Block>"@en;
        rdfs:label       "Synchronized Statement"@en;
        rdfs:subClassOf  woc:Statement .

woc:CodeElement  rdf:type  owl:Class;
        rdfs:comment  "A generic element in source code"@en;
        rdfs:label    "Code Element"@en .

woc:Long   rdf:type      woc:PrimitiveType , owl:NamedIndividual;
        rdfs:comment  "The long type"@en;
        rdfs:label    "Long"@en .

woc:AssertStatement  rdf:type  owl:Class;
        rdfs:comment     "An assert statement"@en;
        rdfs:label       "Assert Statement"@en;
        rdfs:subClassOf  woc:Statement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasAssertExpression;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:hasLine  rdf:type    owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment  "Links a statement to the line it starts in"@en;
        rdfs:domain   [ rdf:type     owl:Class;
                        owl:unionOf  ( woc:Expression woc:Statement )
                      ];
        rdfs:label    "line"@en;
        rdfs:range    xsd:int .

woc:isMethodOf  rdf:type       owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isMethodOf property relates a method to the class, enum or interface it is declared by."@en;
        rdfs:domain         woc:Method;
        rdfs:label          "is method of"@en;
        rdfs:range          woc:ComplexType;
        rdfs:subPropertyOf  woc:isDeclaredBy .

woc:Boolean  rdf:type    woc:PrimitiveType , owl:NamedIndividual;
        rdfs:comment  "The boolean type"@en;
        rdfs:label    "Boolean"@en .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( woc:BreakStatement woc:ContinueStatement woc:ReturnStatement )
] .

woc:hasBuildFile  rdf:type  owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment  "Links a project to the content of its build file.";
        rdfs:domain   woc:Project;
        rdfs:label    "build file";
        rdfs:range    xsd:string .

woc:isTargetOf  rdf:type       owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isTargetOf property relates an expression used as target of a method invocation, to the corresponding method invocation."@en;
        rdfs:domain         woc:Expression;
        rdfs:label          "is target of"@en;
        rdfs:range          woc:MethodInvocationExpression;
        rdfs:subPropertyOf  woc:isSubExpressionOf .

woc:CatchBlock  rdf:type    owl:Class;
        rdfs:comment     "A catch block"@en;
        rdfs:label       "Catch Block"@en;
        rdfs:subClassOf  woc:BlockStatement;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      woc:hasCatchFormalParameter;
                           owl:someValuesFrom  woc:Class
                         ] .

woc:AccessModifier  rdf:type  owl:Class;
        rdfs:comment     "An access modifier"@en;
        rdfs:label       "Access Modifier"@en;
        rdfs:subClassOf  woc:Modifier .

woc:hasCondition  rdf:type     owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasCondition property specifies a condition for a statement to be executed."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:DoStatement woc:ForStatement woc:IfThenElseStatement woc:WhileStatement )
                            ];
        rdfs:label          "has condition"@en;
        rdfs:range          woc:Expression;
        rdfs:subPropertyOf  woc:hasSubExpression;
        owl:inverseOf       woc:isConditionOf .

woc:DoStatement  rdf:type   owl:Class;
        rdfs:comment     "A do-while statement"@en;
        rdfs:label       "Do Statement"@en;
        rdfs:subClassOf  woc:LoopStatement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasCondition;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:Byte   rdf:type      woc:PrimitiveType , owl:NamedIndividual;
        rdfs:comment  "The byte type"@en;
        rdfs:label    "Byte"@en .

woc:Field  rdf:type         owl:Class;
        rdfs:comment     "A class field"@en;
        rdfs:label       "Field"@en;
        rdfs:subClassOf  woc:Variable , woc:Modifiable;
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  [ rdf:type     owl:Class;
                                                owl:unionOf  ( woc:Class woc:Enum woc:Interface )
                                              ];
                           owl:onProperty     woc:isDeclaredBy
                         ];
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  woc:FieldDeclarationStatement;
                           owl:onProperty     woc:hasDeclaration
                         ] .

woc:WhileStatement  rdf:type  owl:Class;
        rdfs:comment     "A while statement"@en;
        rdfs:label       "While Statement"@en;
        rdfs:subClassOf  woc:LoopStatement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasCondition;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:isAssertExpressionOf
        rdf:type            owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isAssertExpressionOf property relates a boolean expression to the assert statement it is contained in."@en;
        rdfs:domain         woc:Expression;
        rdfs:label          "is subexpression of"@en;
        rdfs:range          woc:AssertStatement;
        rdfs:subPropertyOf  woc:isSubExpressionOf .

woc:TypeArgument  rdf:type  owl:Class;
        rdfs:comment     "This class defines the actual type argument of a parameterized type"@en;
        rdfs:label       "Type Argument"@en;
        rdfs:subClassOf  woc:CodeElement .

woc:ActualArgument  rdf:type  owl:Class;
        rdfs:comment     "The actual argument of a method";
        rdfs:label       "Actual Argument";
        rdfs:subClassOf  woc:Expression;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:int;
                           owl:onProperty            woc:hasPosition;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasSubExpression;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:ForStatement  rdf:type  owl:Class;
        rdfs:comment     "A for statement"@en;
        rdfs:label       "For Statement"@en;
        rdfs:subClassOf  woc:LoopStatement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasCondition;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:hasEndLine  rdf:type  owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment  "Links a statement to the number of the last line it covers"@en;
        rdfs:domain   woc:BlockStatement;
        rdfs:label    "end line"@en;
        rdfs:range    xsd:int .

woc:Variable  rdf:type      owl:Class;
        rdfs:comment     "A variable"@en;
        rdfs:label       "Variable"@en;
        rdfs:subClassOf  woc:CodeElement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Type;
                           owl:onProperty            woc:hasType;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:Short  rdf:type      woc:PrimitiveType , owl:NamedIndividual;
        rdfs:comment  "The short type"@en;
        rdfs:label    "Short"@en .

woc:hasSuperBound  rdf:type    owl:ObjectProperty;
        rdfs:comment        "The hasSuperBound property relates a lower bounded wildcard to its bouds."@en;
        rdfs:domain         woc:Wildcard;
        rdfs:label          "has super bound"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:Class woc:Interface woc:ParameterizedType woc:TypeVariable )
                            ];
        rdfs:subPropertyOf  xkos:generalizes .

woc:VariableDeclarationStatement
        rdf:type         owl:Class;
        rdfs:comment     "A statement that represents the declaration of a variable"@en;
        rdfs:label       "Variable Declaration"@en;
        rdfs:subClassOf  woc:DeclarationStatement .

woc:Package  rdf:type       owl:Class;
        rdfs:comment     "A Package"@en;
        rdfs:label       "Package"@en;
        rdfs:subClassOf  woc:CodeElement .

woc:hasActualTypeArgument
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "The hasActualTypeArgument property relates a parameterized type to each of its actual type arguments";
        rdfs:domain   woc:ParameterizedType;
        rdfs:label    "has actual type argument"@en;
        rdfs:range    woc:TypeArgument .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( woc:Class woc:Enum woc:Interface )
] .

woc:hasLabel  rdf:type         owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment        "Links a labeled statement to its label"@en;
        rdfs:domain         woc:Statement;
        rdfs:label          "label"@en;
        rdfs:range          xsd:string;
        rdfs:subPropertyOf  owl:topDataProperty .

woc:TypeVariable  rdf:type  owl:Class;
        rdfs:comment     "A type variable is an unqualified identifier used as a type. It is introduced by the declaration of a generic class, interface, method, or constructor"@en;
        rdfs:label       "Type Variable";
        rdfs:subClassOf  woc:Type;
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  [ rdf:type     owl:Class;
                                                owl:unionOf  ( woc:Class woc:Interface woc:ParameterizedType )
                                              ];
                           owl:onProperty     woc:extends
                         ] .

woc:isThrownBy  rdf:type       owl:ObjectProperty;
        rdfs:comment        "The isThrownBy property relates an exception to the executables it is thrown by."@en;
        rdfs:domain         woc:Class;
        rdfs:label          "is thrown by"@en;
        rdfs:range          woc:Executable;
        rdfs:subPropertyOf  woc:isReferencedBy;
        owl:inverseOf       woc:throws .

woc:Double  rdf:type     woc:PrimitiveType , owl:NamedIndividual;
        rdfs:comment  "The double type"@en;
        rdfs:label    "Double"@en .

woc:hasSubExpression  rdf:type  owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasSubExpression property relates a statement or expression to the expressions it contains."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:Expression woc:Statement )
                            ];
        rdfs:label          "has subexpression"@en;
        rdfs:range          woc:Expression;
        rdfs:subPropertyOf  xkos:hasPart;
        owl:inverseOf       woc:isSubExpressionOf .

woc:isFinallyClauseOf  rdf:type  owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isFinallyClauseOf property relates the statement enclosed in a finally clause to the corresponding try statement."@en;
        rdfs:domain         woc:FinallyBlock;
        rdfs:label          "is finally clause of"@en;
        rdfs:range          woc:TryStatement;
        rdfs:subPropertyOf  woc:isSubStatementOf .

woc:hasTargetedLabel  rdf:type  owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment  "Links a break statement or a continue statement to the label it targets, if any"@en;
        rdfs:domain   [ rdf:type     owl:Class;
                        owl:unionOf  ( woc:BreakStatement woc:ContinueStatement )
                      ];
        rdfs:label    "targeted label";
        rdfs:range    xsd:string .

woc:hasAssertExpression  rdf:type  owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasAssertExpression property relates an assert statement to the boolean expression asserted to be true"@en;
        rdfs:domain         woc:AssertStatement;
        rdfs:label          "has assert expression"@en;
        rdfs:range          woc:Expression;
        rdfs:subPropertyOf  woc:hasSubExpression;
        owl:inverseOf       woc:isAssertExpressionOf .

[ rdf:type             owl:AllDifferent;
  owl:distinctMembers  ( woc:Abstract woc:Boolean woc:Byte woc:Char woc:Default woc:Double woc:Final woc:Float woc:Int woc:Long woc:Private woc:Protected woc:Public woc:Short woc:Static woc:Synchronized woc:Volatile )
] .

woc:isReferencedBy  rdf:type  owl:ObjectProperty;
        rdfs:comment   "The isReferencedBy property relates a code element to the elements it is referenced by."@en;
        rdfs:domain    woc:CodeElement;
        rdfs:label     "is referenced by"@en;
        rdfs:range     woc:CodeElement;
        owl:inverseOf  woc:references .

woc:hasMethod  rdf:type        owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The ihasMehtod property relates a class to its methods.";
        rdfs:domain         woc:ComplexType;
        rdfs:label          "has method"@en;
        rdfs:range          woc:Method;
        rdfs:subPropertyOf  woc:declares;
        owl:inverseOf       woc:isMethodOf .

woc:ComplexType  rdf:type   owl:Class;
        rdfs:comment     "A class or an enumeration or an interface"@en;
        rdfs:label       "Complex Type"@en;
        rdfs:subClassOf  woc:Type , woc:Modifiable .

woc:isAnnotationOf  rdf:type  owl:ObjectProperty;
        rdfs:comment  "The isAnnotationOf property relates an annotation to the annotated code element."@en;
        rdfs:domain   woc:AnnotationType;
        rdfs:label    "is annotation of"@en;
        rdfs:range    woc:CodeElement .

xkos:hasPart  rdf:type  owl:ObjectProperty .

woc:isConstructorOf  rdf:type  owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isConstructorOf property relates a constructor to the class it is declared by."@en;
        rdfs:domain         woc:Constructor;
        rdfs:label          "is constructor of"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:Class woc:Enum )
                            ];
        rdfs:subPropertyOf  woc:isDeclaredBy .

woc:AnnotationType  rdf:type  owl:Class;
        rdfs:comment     "An annotation"@en;
        rdfs:label       "Annotation"@en;
        rdfs:subClassOf  woc:Type .

woc:hasReturnedExpression
        rdf:type            owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasReturnedExpression property relates a return statement to the returned expression"@en;
        rdfs:domain         woc:ReturnStatement;
        rdfs:label          "has returned expression"@en;
        rdfs:range          woc:Expression;
        rdfs:subPropertyOf  woc:hasSubExpression;
        owl:inverseOf       woc:isReturnedExpressionOf .

woc:Project  rdf:type    owl:Class;
        rdfs:comment  "A project"@en;
        rdfs:label    "Project"@en .

woc:isElseBranchOf  rdf:type   owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isElseBranchOf property relates the statement in an else branch to the corresponding If-then-else statement"@en;
        rdfs:domain         woc:Statement;
        rdfs:label          "is else branch of"@en;
        rdfs:range          woc:IfThenElseStatement;
        rdfs:subPropertyOf  woc:isSubStatementOf .

woc:hasFinallyClause  rdf:type  owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasFinallyClause property relates a try statemet to its finally clause."@en;
        rdfs:domain         woc:TryStatement;
        rdfs:label          "has finally clause"@en;
        rdfs:range          woc:FinallyBlock;
        rdfs:subPropertyOf  woc:hasSubStatement;
        owl:inverseOf       woc:isFinallyClauseOf .

woc:Abstract  rdf:type   woc:Modifier , owl:NamedIndividual;
        rdfs:comment  "The abstract modifier"@en;
        rdfs:label    "Abstract"@en .

woc:hasCatchClause  rdf:type   owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasCatchClause property relates a try statement to the relative catch clauses."@en;
        rdfs:domain         woc:TryStatement;
        rdfs:label          "has catch clause"@en;
        rdfs:range          woc:CatchBlock;
        rdfs:subPropertyOf  woc:hasSubStatement;
        owl:inverseOf       woc:isCatchClauseOf .

woc:Synchronized  rdf:type  woc:Modifier , owl:NamedIndividual;
        rdfs:comment  "The synchronized modifier"@en;
        rdfs:label    "Synchronized"@en .

woc:hasForUpdate  rdf:type     owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasForUpdate property relates a basic for statement to each expression evaluated as update code at the end of every iteration"@en;
        rdfs:domain         woc:ForStatement;
        rdfs:label          "has for update"@en;
        rdfs:range          woc:Expression;
        rdfs:subPropertyOf  woc:hasSubExpression;
        owl:inverseOf       woc:isForUpdateOf .

woc:returns  rdf:type    owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment  "The returns property relates a method to the variable it returns, if any."@en;
        rdfs:domain   woc:Method;
        rdfs:label    "returns"@en;
        rdfs:range    woc:Variable .

woc:hasPosition  rdf:type  owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment  "Links a element to its position"@en;
        rdfs:domain   woc:CodeElement;
        rdfs:label    "position"@en;
        rdfs:range    xsd:int .

woc:ContinueStatement  rdf:type  owl:Class;
        rdfs:comment     "A continue statement"@en;
        rdfs:label       "Continue Statement"@en;
        rdfs:subClassOf  woc:BranchingStatement .

woc:Float  rdf:type      woc:PrimitiveType , owl:NamedIndividual;
        rdfs:comment  "The float type"@en;
        rdfs:label    "Float"@en .

woc:isTypeOf  rdf:type   owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment  "The isTypeOf property relates a type to the elements of that type."@en;
        rdfs:domain   woc:Type;
        rdfs:label    "is type of"@en;
        rdfs:range    [ rdf:type     owl:Class;
                        owl:unionOf  ( woc:Expression woc:Method woc:Variable )
                      ] .

woc:Char   rdf:type      woc:PrimitiveType , owl:NamedIndividual;
        rdfs:comment  "The char type"@en;
        rdfs:label    "Char"@en .

woc:isSwitchLabelOf  rdf:type  owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isSwitchLabelOf property relates a case labeled block or a default block to the corresponding switch statement."@en;
        rdfs:domain         woc:LabeledBlock;
        rdfs:label          "is switch label of"@en;
        rdfs:range          woc:SwitchStatement;
        rdfs:subPropertyOf  woc:isSubStatementOf .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( woc:CatchBlock woc:FinallyBlock woc:LabeledBlock )
] .

woc:Static  rdf:type     woc:Modifier , owl:NamedIndividual;
        rdfs:comment  "The static modifier"@en;
        rdfs:label    "Static"@en .

woc:hasGenericType  rdf:type  owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment  "The hasGenericType property relates a parameterized type to the generic type it is a parameterization of"@en;
        rdfs:domain   woc:ParameterizedType;
        rdfs:label    "has generic type"@en;
        rdfs:range    [ rdf:type     owl:Class;
                        owl:unionOf  ( woc:Class woc:Interface woc:TypeVariable woc:Wildcard )
                      ] .

woc:hasDependency  rdf:type  owl:ObjectProperty;
        rdfs:comment   "The hasDependency property relates a project to its dependencies."@en;
        rdfs:domain    woc:Project;
        rdfs:label     "has dependency"@en;
        rdfs:range     woc:Library;
        owl:inverseOf  woc:isDependencyOf .

woc:hasElseBranch  rdf:type    owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasElseBranch property relates a if-then-else statement to the statement in the else branch."@en;
        rdfs:domain         woc:IfThenElseStatement;
        rdfs:label          "has else branch"@en;
        rdfs:range          woc:Statement;
        rdfs:subPropertyOf  woc:hasSubStatement;
        owl:inverseOf       woc:isElseBranchOf .

woc:hasSubProject  rdf:type    owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasSubProject property relates a project to its subprojects"@en;
        rdfs:domain         woc:Project;
        rdfs:label          "has subproject"@en;
        rdfs:range          woc:Project;
        rdfs:subPropertyOf  xkos:hasPart;
        owl:inverseOf       woc:isSubProjectOf .

woc:isProjectOf  rdf:type      owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isProjectOf property relates a project to the packages it contains."@en;
        rdfs:domain         woc:Project;
        rdfs:label          "is project of"@en;
        rdfs:range          woc:Package;
        rdfs:subPropertyOf  xkos:hasPart .

woc:hasProject  rdf:type       owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasProject property relates a package to the project it belongs to.";
        rdfs:domain         woc:Package;
        rdfs:label          "has project"@en;
        rdfs:range          woc:Project;
        rdfs:subPropertyOf  xkos:isPartOf;
        owl:inverseOf       woc:isProjectOf .

woc:Modifier  rdf:type      owl:Class;
        rdfs:comment     "A modifier"@en;
        rdfs:label       "Modifier"@en;
        rdfs:subClassOf  woc:CodeElement .

woc:Statement  rdf:type     owl:Class;
        rdfs:comment     "A generic statement";
        rdfs:label       "Statement";
        rdfs:subClassOf  woc:CodeElement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:int;
                           owl:onProperty            woc:hasPosition;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:int;
                           owl:onProperty            woc:hasLine;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:hasField  rdf:type         owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasField property relates a class to its fields"@en;
        rdfs:domain         woc:ComplexType;
        rdfs:label          "has field"@en;
        rdfs:range          woc:Field;
        rdfs:subPropertyOf  woc:declares;
        owl:inverseOf       woc:isFieldOf .

woc:isDependencyOf  rdf:type  owl:ObjectProperty;
        rdfs:comment  "The isDependencyOf property relates a library to the projects that depend on this library."@en;
        rdfs:domain   woc:Library;
        rdfs:label    "is dependency of"@en;
        rdfs:range    woc:Project .

woc:Modifiable  rdf:type    owl:Class;
        rdfs:comment     "An element that can have a modifier"@en;
        rdfs:label       "Modifiable"@en;
        rdfs:subClassOf  woc:CodeElement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:AccessModifier;
                           owl:onProperty            woc:hasModifier;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      woc:hasModifier;
                           owl:someValuesFrom  woc:Modifier
                         ] .

woc:isFieldOf  rdf:type        owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isFieldOf property relates a field to the class, interface or enum it is declared by."@en;
        rdfs:domain         woc:Field;
        rdfs:label          "is field of"@en;
        rdfs:range          woc:ComplexType;
        rdfs:subPropertyOf  woc:isDeclaredBy .

woc:overrides  rdf:type        owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The overrides property relates a method to the method it overrides."@en;
        rdfs:domain         woc:Method;
        rdfs:label          "overrides"@en;
        rdfs:range          woc:Method;
        rdfs:subPropertyOf  xkos:specializes .

woc:isOverriddenBy  rdf:type   owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isOverridenBy property relates a method to the ones it is overridden by."@en;
        rdfs:domain         woc:Method;
        rdfs:label          "is overridden by"@en;
        rdfs:range          woc:Method;
        rdfs:subPropertyOf  xkos:generalizes;
        owl:inverseOf       woc:overrides .

woc:FieldDeclarationStatement
        rdf:type          owl:Class;
        rdfs:comment      "The declaration of a field"@en;
        rdfs:label        "Field Declaration"@en;
        rdfs:subClassOf   woc:VariableDeclarationStatement;
        owl:disjointWith  woc:LocalVariableDeclarationStatement .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( woc:AssertStatement woc:BlockStatement woc:ControlFlowStatement woc:DeclarationStatement woc:ExpressionStatement woc:SynchronizedStatement woc:ThrowStatement woc:TryStatement )
] .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( woc:Field woc:LocalVariable woc:Parameter )
] .

woc:MavenProject  rdf:type  owl:Class;
        rdfs:comment     "A maven project"@en;
        rdfs:label       "Maven Project"@en;
        rdfs:subClassOf  woc:Project .

woc:BlockStatement  rdf:type  owl:Class;
        rdfs:comment     "A block"@en;
        rdfs:label       "Block Statement"@en;
        rdfs:subClassOf  woc:Statement .

woc:ForEachStatement  rdf:type  owl:Class;
        rdfs:comment     "A for-each statement, also known as enhanced for statement"@en;
        rdfs:label       "ForEach Statement"@en;
        rdfs:subClassOf  woc:LoopStatement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Variable;
                           owl:onProperty            woc:hasVariable;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasSubExpression;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:isSubProjectOf  rdf:type   owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isSubProjectOf property relates a project to its parent project."@en;
        rdfs:domain         woc:Project;
        rdfs:label          "is subproject of"@en;
        rdfs:range          woc:Project;
        rdfs:subPropertyOf  xkos:isPartOf .

woc:Expression  rdf:type    owl:Class;
        rdfs:comment     "A generic expression";
        rdfs:label       "Expression";
        rdfs:subClassOf  woc:CodeElement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:int;
                           owl:onProperty            woc:hasLine;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Type;
                           owl:onProperty            woc:hasType;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:ClassInstanceCreationExpression
        rdf:type          owl:Class;
        rdfs:comment      "An expression that creates a class instance, in other words a constructor call"@en;
        rdfs:label        "Class Instance Creation Expression"@en;
        rdfs:subClassOf   woc:ExecutableInvocationExpression;
        owl:disjointWith  woc:MethodInvocationExpression .

woc:hasPreviousStatement
        rdf:type            owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasPreviousStatement property relates a statement to the previous one."@en;
        rdfs:domain         woc:Statement;
        rdfs:label          "has previous statement"@en;
        rdfs:range          woc:Statement;
        rdfs:subPropertyOf  xkos:previous .

woc:hasForInit  rdf:type       owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasForInit property relates a basic for statement to each statement expression executed as initialization code, before the first iteration step is performed"@en;
        rdfs:domain         woc:ForStatement;
        rdfs:label          "has for init"@en;
        rdfs:range          woc:Expression;
        rdfs:subPropertyOf  woc:hasSubExpression;
        owl:inverseOf       woc:isForInitOf .

woc:ArrayType  rdf:type     owl:Class;
        rdfs:comment     "An array type"@en;
        rdfs:label       "Array"@en;
        rdfs:subClassOf  woc:Type;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:int;
                           owl:onProperty            woc:hasDimensions;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Type;
                           owl:onProperty            woc:isArrayOf;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:isForInitOf  rdf:type      owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isForInitOf property relates an expression executed as initialization code of a basic for statement to the relative for statement."@en;
        rdfs:domain         woc:Expression;
        rdfs:label          "is for init of"@en;
        rdfs:range          woc:ForStatement;
        rdfs:subPropertyOf  woc:isSubExpressionOf .

woc:constructs  rdf:type       owl:ObjectProperty;
        rdfs:comment        "The constructs property relates an executable to the classes it constructs."@en;
        rdfs:domain         woc:Executable;
        rdfs:label          "constructs"@en;
        rdfs:range          woc:Class;
        rdfs:subPropertyOf  woc:references;
        owl:inverseOf       woc:isConstructedBy .

woc:implements  rdf:type       owl:ObjectProperty;
        rdfs:comment        "The implements property relates a class to each implemented interface."@en;
        rdfs:domain         woc:Class;
        rdfs:label          "implements"@en;
        rdfs:range          woc:Interface;
        rdfs:subPropertyOf  xkos:specializes;
        owl:inverseOf       woc:isImplementedBy .

woc:isConditionOf  rdf:type    owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isConditionOf property relates a if-then-else statement or a loop to its condition."@en;
        rdfs:domain         woc:Expression;
        rdfs:label          "is condition of"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:DoStatement woc:ForStatement woc:IfThenElseStatement woc:WhileStatement )
                            ];
        rdfs:subPropertyOf  woc:isSubExpressionOf .

woc:isSubStatementOf  rdf:type  owl:ObjectProperty;
        rdfs:comment        "The isSubStatementOf property relates a statement to the method, constructor or statement it is contained in.";
        rdfs:domain         woc:Statement;
        rdfs:label          "is substatement of"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:Executable woc:Statement )
                            ];
        rdfs:subPropertyOf  xkos:isPartOf .

xkos:previous  rdf:type  owl:ObjectProperty .

woc:isArrayOf  rdf:type  owl:ObjectProperty;
        rdfs:comment  "The isArrayOf property relates an arrray to the type of its elements at the finest grain. For instance, an array of type \"int[][][]\" is linked to the type \"int\". The number of dimensions of the array is specified by the dimensions property."@en;
        rdfs:domain   woc:ArrayType;
        rdfs:label    "is array of"@en;
        rdfs:range    woc:Type .

woc:    rdf:type      owl:Ontology;
        rdfs:comment  "An ontology that represents object-oriented programming languages"@en;
        rdfs:label    "CodeOntology"@en .

woc:isDeclaredBy  rdf:type     owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isDeclaredBy property relates a code element to the element it is declared by."@en;
        rdfs:domain         woc:CodeElement;
        rdfs:label          "is declared by"@en;
        rdfs:range          woc:CodeElement;
        rdfs:subPropertyOf  xkos:isPartOf .

woc:hasPackage  rdf:type       owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasPackage property relates a class, interface, enum or annotation to the package it is declared by."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:AnnotationType woc:ComplexType )
                            ];
        rdfs:label          "has package"@en;
        rdfs:range          woc:Package;
        rdfs:subPropertyOf  woc:isDeclaredBy;
        owl:inverseOf       woc:isPackageOf .

woc:Parameter  rdf:type     owl:Class;
        rdfs:comment     "A formal parameter"@en;
        rdfs:label       "Parameter"@en;
        rdfs:subClassOf  woc:Variable;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onDataRange           xsd:int;
                           owl:onProperty            woc:hasPosition;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:Private  rdf:type    woc:AccessModifier , owl:NamedIndividual;
        rdfs:comment  "The private modifier"@en;
        rdfs:label    "Private"@en .

woc:Wildcard  rdf:type      owl:Class;
        rdfs:comment     "A wildcard"@en;
        rdfs:label       "Wildcard"@en;
        rdfs:subClassOf  woc:Type;
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  woc:Type;
                           owl:onProperty     woc:hasSuperBound
                         ];
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  [ rdf:type     owl:Class;
                                                owl:unionOf  ( woc:Class woc:Interface woc:ParameterizedType )
                                              ];
                           owl:onProperty     woc:extends
                         ] .

woc:LocalVariable  rdf:type  owl:Class;
        rdfs:comment     "A local variable"@en;
        rdfs:label       "Local Variable"@en;
        rdfs:subClassOf  woc:Variable;
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  woc:Executable;
                           owl:onProperty     woc:isDeclaredBy
                         ] .

woc:hasSwitchLabel  rdf:type   owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasSwitchLabel property relates a switch statement to its cases."@en;
        rdfs:domain         woc:SwitchStatement;
        rdfs:label          "has switch label"@en;
        rdfs:range          woc:LabeledBlock;
        rdfs:subPropertyOf  woc:hasSubStatement;
        owl:inverseOf       woc:isSwitchLabelOf .

woc:hasSourceCode  rdf:type  owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment  "Links a element to its source code"@en;
        rdfs:domain   woc:CodeElement;
        rdfs:label    "source code"@en;
        rdfs:range    xsd:string .

woc:FinallyBlock  rdf:type  owl:Class;
        rdfs:comment     "A finally block"@en;
        rdfs:label       "Finally Block"@en;
        rdfs:subClassOf  woc:BlockStatement .

woc:isConstructedBy  rdf:type  owl:ObjectProperty;
        rdfs:comment        "The isConstructedBy property relates a class to the executables that instantiates objects of that class."@en;
        rdfs:domain         woc:Class;
        rdfs:label          "is constructed by"@en;
        rdfs:range          woc:Executable;
        rdfs:subPropertyOf  woc:isReferencedBy .

woc:CaseLabeledBlock  rdf:type  owl:Class;
        rdfs:comment     "A case-labeled list of statements"@en;
        rdfs:label       "Case Labeled Block"@en;
        rdfs:subClassOf  woc:LabeledBlock;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasSubExpression;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:Constructor  rdf:type    owl:Class;
        rdfs:comment      "A constructor of a Class"@en;
        rdfs:label        "Constructor"@en;
        rdfs:subClassOf   woc:Executable;
        owl:disjointWith  woc:Method .

woc:LoopStatement  rdf:type  owl:Class;
        rdfs:comment     "A loop statement."@en;
        rdfs:label       "Loop Statement"@en;
        rdfs:subClassOf  woc:ControlFlowStatement;
        rdfs:subClassOf  [ rdf:type                     owl:Restriction;
                           owl:maxQualifiedCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onClass                  woc:BlockStatement;
                           owl:onProperty               woc:hasBody
                         ] .

woc:GradleProject  rdf:type  owl:Class;
        rdfs:comment     "A gradle project"@en;
        rdfs:label       "Gradle Project"@en;
        rdfs:subClassOf  woc:Project .

woc:hasArgument  rdf:type  owl:ObjectProperty;
        rdfs:comment  "The hasArgument property relates an executable invocation to each of its actual arguments."@en;
        rdfs:domain   woc:ExecutableInvocationExpression;
        rdfs:label    "has argument"@en;
        rdfs:range    woc:ActualArgument .

woc:ClassDeclarationStatement
        rdf:type          owl:Class;
        rdfs:comment      "A statement that corresponds to the declaration of a local class"@en;
        rdfs:label        "Class Declaration Statement"@en;
        rdfs:subClassOf   woc:DeclarationStatement;
        owl:disjointWith  woc:VariableDeclarationStatement .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( woc:AnnotationType woc:ArrayType woc:ComplexType woc:ParameterizedType woc:PrimitiveType woc:TypeVariable woc:Wildcard )
] .

xkos:next  rdf:type  owl:ObjectProperty .

woc:Interface  rdf:type     owl:Class;
        rdfs:comment     "An interface"@en;
        rdfs:label       "Interface"@en;
        rdfs:subClassOf  woc:ComplexType;
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  woc:Interface;
                           owl:onProperty     woc:extends
                         ] .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( woc:Executable woc:Expression woc:Modifier woc:Package woc:Statement woc:Type woc:TypeArgument woc:Variable )
] .

woc:IfThenElseStatement  rdf:type  owl:Class;
        rdfs:comment      "A If-then-else statement"@en;
        rdfs:label        "If-then-else statement"@en;
        rdfs:subClassOf   woc:DecisionMakingStatement;
        rdfs:subClassOf   [ rdf:type                  owl:Restriction;
                            owl:onClass               woc:Statement;
                            owl:onProperty            woc:hasThenBranch;
                            owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                          ];
        rdfs:subClassOf   [ rdf:type                  owl:Restriction;
                            owl:onClass               woc:Expression;
                            owl:onProperty            woc:hasCondition;
                            owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                          ];
        owl:disjointWith  woc:SwitchStatement .

woc:MethodInvocationExpression
        rdf:type         owl:Class;
        rdfs:comment     "A method call"@en;
        rdfs:label       "Method Invocation Expression"@en;
        rdfs:subClassOf  woc:ExecutableInvocationExpression .

woc:ParameterizedType  rdf:type  owl:Class;
        rdfs:comment     "A parameterized type is a particular parameterization of a generic type denoted by a specified list of type arguments"@en;
        rdfs:label       "Parameterized Type";
        rdfs:subClassOf  woc:Type;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:ComplexType;
                           owl:onProperty            woc:hasGenericType;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      woc:hasActualTypeArgument;
                           owl:someValuesFrom  woc:TypeArgument
                         ] .

woc:declares  rdf:type         owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The declares property relates a code element to the elements it declares. For instance, a class is linked to its fields, methods and constructors.";
        rdfs:domain         woc:CodeElement;
        rdfs:label          "declares"@en;
        rdfs:range          woc:CodeElement;
        rdfs:subPropertyOf  xkos:hasPart;
        owl:inverseOf       woc:isDeclaredBy .

xkos:isPartOf  rdf:type  owl:ObjectProperty .

woc:ControlFlowStatement
        rdf:type         owl:Class;
        rdfs:comment     "A control flow statement, that is a statement that regulates the order in which statements are executed.\nControl Flow Statements break up the flow of execution by employing decision making, looping, or branching."@en;
        rdfs:label       "Control Flow Statement"@en;
        rdfs:subClassOf  woc:Statement .

woc:hasFormalTypeParameter
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "The hasFormalTypeParameter property relates a class, an interface, an enumeration, a constructor or a method to the formal type parameters it declares"@en;
        rdfs:domain   [ rdf:type     owl:Class;
                        owl:unionOf  ( woc:Class woc:Enum woc:Executable woc:Interface )
                      ];
        rdfs:label    "has formal type parameter"@en;
        rdfs:range    woc:TypeVariable .

woc:hasSubStatement  rdf:type  owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasSubStatement property relates a statment to its sub-statements."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:Executable woc:Statement )
                            ];
        rdfs:label          "has substatement"@en;
        rdfs:range          woc:Statement;
        rdfs:subPropertyOf  xkos:hasPart;
        owl:inverseOf       woc:isSubStatementOf .

woc:isReturnTypeOf  rdf:type   owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isReturnTypeOf property relates a type to the methods that return objects of that type."@en;
        rdfs:domain         woc:Type;
        rdfs:label          "is return type of"@en;
        rdfs:range          woc:Method;
        rdfs:subPropertyOf  woc:isTypeOf .

woc:hasName  rdf:type    owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment  "Links a element to its name"@en;
        rdfs:domain   [ rdf:type     owl:Class;
                        owl:unionOf  ( woc:CodeElement woc:Library woc:Project )
                      ];
        rdfs:label    "name"@en;
        rdfs:range    xsd:string .

woc:AnonymousClass  rdf:type  owl:Class;
        rdfs:comment     "An anonymous class"@en;
        rdfs:label       "Anonymous Class"@en;
        rdfs:subClassOf  woc:Class .

woc:Int    rdf:type      woc:PrimitiveType , owl:NamedIndividual;
        rdfs:comment  "The int type"@en;
        rdfs:label    "Int"@en .

woc:hasDeclaration  rdf:type   owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasDeclaration property relates a variable to the statement it was declared by."@en;
        rdfs:domain         woc:Variable;
        rdfs:label          "has declaration"@en;
        rdfs:range          woc:VariableDeclarationStatement;
        rdfs:subPropertyOf  owl:topObjectProperty .

woc:ThrowStatement  rdf:type  owl:Class;
        rdfs:comment     "A throw statement, that is a statement that causes an exception to be thrown"@en;
        rdfs:label       "Throw Statement"@en;
        rdfs:subClassOf  woc:Statement;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Expression;
                           owl:onProperty            woc:hasThrownExpression;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

woc:DeclarationStatement
        rdf:type         owl:Class;
        rdfs:comment     "A statement that holds a declaration"@en;
        rdfs:label       "Declaration statement"@en;
        rdfs:subClassOf  woc:Statement .

woc:hasVariable  rdf:type  owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment  "The hasVariable property relates a for-each statement to the local variable it declares."@en;
        rdfs:domain   woc:ForEachStatement;
        rdfs:label    "has variable"@en;
        rdfs:range    woc:LocalVariable .

woc:extends  rdf:type          owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The extends property relates a class, an interface, a type variable or a wildacard to the types it extends."@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:Class woc:Interface woc:TypeVariable woc:Wildcard )
                            ];
        rdfs:label          "extends"@en;
        rdfs:subPropertyOf  xkos:specializes;
        owl:inverseOf       woc:hasSubClass .

woc:isForUpdateOf  rdf:type    owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The isForUpdateOf property relates an expression evaluated as update code of a for statement at the end of every iteration, to the corresponding for statement."@en;
        rdfs:domain         woc:Expression;
        rdfs:label          "is for update of"@en;
        rdfs:range          woc:ForStatement;
        rdfs:subPropertyOf  woc:isSubExpressionOf .

woc:hasSubClass  rdf:type      owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasSubClass property relates a class to its direct sub-classes"@en;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:Class woc:Interface woc:TypeVariable woc:Wildcard )
                            ];
        rdfs:label          "has subclass"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( woc:AnnotationType woc:ComplexType )
                            ];
        rdfs:subPropertyOf  xkos:generalizes .

woc:references  rdf:type  owl:ObjectProperty;
        rdfs:comment  "The references property relates a method or a constructor to the types, methods, constructors and fields it references."@en;
        rdfs:domain   woc:CodeElement;
        rdfs:label    "references"@en;
        rdfs:range    woc:CodeElement .

woc:Protected  rdf:type  woc:AccessModifier , owl:NamedIndividual;
        rdfs:comment  "The protected modifier"@en;
        rdfs:label    "Protected"@en .

woc:hasParameter  rdf:type  owl:InverseFunctionalProperty , owl:ObjectProperty;
        rdfs:comment   "The hasParameter property relates a constructor or a method to the formal parameters it declares"@en;
        rdfs:domain    woc:Executable;
        rdfs:label     "has parameter"@en;
        rdfs:range     woc:Parameter;
        owl:inverseOf  woc:isParameterOf .

woc:hasReturnType  rdf:type    owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment        "The hasReturnType property relates a method to its return type."@en;
        rdfs:domain         woc:Method;
        rdfs:label          "has return type"@en;
        rdfs:range          woc:Type;
        rdfs:subPropertyOf  woc:hasType;
        owl:inverseOf       woc:isReturnTypeOf .

woc:hasDimensions  rdf:type  owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:comment  "Links an array to the number of its dimensions. As an example, an array of type \"int[][][]\" has a dimensions count of 3"@en;
        rdfs:domain   woc:ArrayType;
        rdfs:label    "dimensions"@en;
        rdfs:range    xsd:int .

woc:PrimitiveType  rdf:type  owl:Class;
        rdfs:comment     "A primitive type";
        rdfs:label       "Primitive Type";
        rdfs:subClassOf  woc:Type .

woc:ExecutableInvocationExpression
        rdf:type         owl:Class;
        rdfs:comment     "An invocation of either a method or a constructor."@en;
        rdfs:label       "Executable invocation expression"@en;
        rdfs:subClassOf  woc:Expression;
        rdfs:subClassOf  [ rdf:type                  owl:Restriction;
                           owl:onClass               woc:Executable;
                           owl:onProperty            woc:invokes;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .
