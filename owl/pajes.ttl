@prefix icodm: <https://github.com/Incodam/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix woc:   <http://rdf.webofcode.org/woc/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<https://github.com/Incodam/pajes/ontology>
    a owl:Ontology ;
    rdfs:label "Pajes ontology"@en ;
    rdfs:comment "OWL 2 vocabulary for Pajes Java module, library dependency, API, patch, and client-use RDF data."@en ;
    owl:versionInfo "1.0" .

#################################################################
# Classes
#################################################################

woc:Interface
    a owl:Class ;
    rdfs:label "Java interface"@en ;
    rdfs:comment "A Java interface declaration represented as a Web of Code class resource."@en ;
    rdfs:subClassOf woc:Class .

icodm:JavaModule
    a owl:Class ;
    rdfs:label "Java module"@en ;
    rdfs:comment "A Java project module represented in Pajes data."@en .

icodm:JavaSubModule
    a owl:Class ;
    rdfs:label "Java submodule"@en ;
    rdfs:comment "A Java submodule contained in a Java module."@en ;
    rdfs:subClassOf woc:Package .

icodm:JavaLibrary
    a owl:Class ;
    rdfs:label "Java library"@en ;
    rdfs:comment "A Java library or package used as a dependency target."@en ;
    rdfs:subClassOf woc:Package .

icodm:LibraryDependency
    a owl:Class ;
    rdfs:label "Library dependency"@en ;
    rdfs:comment "A versioned dependency on a Java library for a target package and branch."@en .

icodm:ApiClientConstraint
    a owl:Class ;
    rdfs:label "API client constraint"@en ;
    rdfs:comment "A configured constraint extracted from a client use of an API method or type."@en .

icodm:ApiClientConstraintSet
    a owl:Class ;
    rdfs:label "API client constraint set"@en ;
    rdfs:comment "An ordered set of parameter constraints associated with one API method call."@en .

icodm:JavaConstraintAnnotation
    a owl:Class ;
    rdfs:label "Java constraint annotation"@en ;
    rdfs:comment "A Java annotation represented as a constraint in client-use data."@en ;
    rdfs:subClassOf woc:Annotation .

icodm:CoProperty
    a owl:Class ;
    rdfs:label "Condition property"@en ;
    rdfs:comment "A named property-value resource represented using rdfs:label and rdf:value."@en .

icodm:CoAProperty
    a owl:Class ;
    rdfs:subClassOf icodm:CoProperty ;
    rdfs:label "Constraint annotation property"@en ;
    rdfs:comment "A named property value transferred from a Java constraint annotation."@en .


# Controlled Term Framework Classes

icodm:ControlledTerm a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Controlled Term"@en ;
    rdfs:comment "The base class for all semantic controlled concepts mapped to source code entities."@en .

# refmodule extension with contracts

icodm:ApiContract
    a owl:Class ;
    rdfs:label "API semantic contract"@en ;
    rdfs:comment "A semantic contract attached to an API method or type."@en .

icodm:ApiConditionSet
    a owl:Class ;
    rdfs:subClassOf icodm:ApiContract ;
    rdfs:label "API set of semantic conditions"@en ;
    rdfs:comment "A contract grouping one or more semantic conditions."@en .

icodm:ApiCondition
    a owl:Class ;
    rdfs:label "API semantic condition"@en ;
    rdfs:comment "Defines an individual semantic condition."@en .

icodm:ApiCoProperty
    a owl:Class ;
    rdfs:subClassOf icodm:CoProperty ;
    rdfs:label "Semantic condition property"@en ;
    rdfs:comment "A semantic condition property represented using rdfs:label for its name and rdf:value for its value."@en .

icodm:JavaContractAnnotation
    a owl:Class ;
    rdfs:subClassOf woc:Annotation, icodm:ApiCondition ;
    rdfs:label "Java contract annotation"@en ;
    rdfs:comment "A future Java-annotation-based representation of an API semantic condition."@en .

#################################################################
# Object properties
#################################################################

icodm:hasSubModule
    a owl:ObjectProperty ;
    rdfs:label "has submodule"@en ;
    rdfs:domain icodm:JavaModule ;
    rdfs:range icodm:JavaSubModule .

icodm:hasDependency
    a owl:ObjectProperty ;
    rdfs:label "has dependency"@en ;
    rdfs:domain icodm:JavaSubModule ;
    rdfs:range icodm:LibraryDependency .

icodm:targetPackage
    a owl:ObjectProperty ;
    rdfs:label "target package"@en ;
    rdfs:comment "The Java package supplied by the dependency."@en ;
    rdfs:domain icodm:LibraryDependency ;
    rdfs:range woc:Package .

icodm:isNewConstructor
    a owl:ObjectProperty ;
    rdfs:label "is new constructor of"@en ;
    rdfs:comment "Links a constructor introduced by a patch to its containing class."@en ;
    rdfs:domain woc:Constructor ;
    rdfs:range woc:Class .

icodm:isPatchOfConstructor
    a owl:ObjectProperty ;
    rdfs:label "is patch of constructor"@en ;
    rdfs:comment "Links a patched constructor record to the corresponding stable constructor record."@en ;
    rdfs:domain woc:Constructor ;
    rdfs:range woc:Constructor .

icodm:isNewMethod
    a owl:ObjectProperty ;
    rdfs:label "is new method of"@en ;
    rdfs:comment "Links a method introduced by a patch to its containing class."@en ;
    rdfs:domain woc:Method ;
    rdfs:range woc:Class .

icodm:isPatchOfMethod
    a owl:ObjectProperty ;
    rdfs:label "is patch of method"@en ;
    rdfs:comment "Links a patched method record to the corresponding stable method record."@en ;
    rdfs:domain woc:Method ;
    rdfs:range woc:Method .

icodm:isDeleted
    a owl:ObjectProperty ;
    rdfs:label "is deleted"@en ;
    rdfs:comment "Marks a Java type resource as deleted by linking it to itself."@en ;
    rdfs:domain woc:Class ;
    rdfs:range woc:Class .

icodm:onMethodCall
    a owl:ObjectProperty ;
    rdfs:label "constraint on method call"@en ;
    rdfs:domain woc:Class ;
    rdfs:range icodm:ApiClientConstraintSet .

icodm:onMethodReturn
    a owl:ObjectProperty ;
    rdfs:label "constraint on method return"@en ;
    rdfs:domain woc:Class ;
    rdfs:range icodm:ApiClientConstraint .

icodm:onCallback
    a owl:ObjectProperty ;
    rdfs:label "constraint on callback parameters"@en ;
    rdfs:domain woc:Class ;
    rdfs:range icodm:ApiClientConstraintSet .

icodm:onCallbackReturn
    a owl:ObjectProperty ;
    rdfs:label "constraint on callback return"@en ;
    rdfs:domain woc:Class ;
    rdfs:range icodm:ApiClientConstraint .

icodm:onTypeUse
    a owl:ObjectProperty ;
    rdfs:label "constraint on API type use"@en ;
    rdfs:domain woc:Class ;
    rdfs:range icodm:ApiClientConstraint .

icodm:hasContraints
    a owl:ObjectProperty ;
    rdfs:label "has constraints"@en ;
    rdfs:comment "The spelling is retained for compatibility with generated client-use RDF."@en ;
    rdfs:domain icodm:ApiClientConstraintSet ;
    rdfs:range rdf:List .

icodm:annotations
    a owl:ObjectProperty ;
    rdfs:label "annotations"@en ;
    rdfs:domain icodm:ApiClientConstraint ;
    rdfs:range icodm:JavaConstraintAnnotation .

icodm:annotationProperties
    a owl:ObjectProperty ;
    rdfs:label "annotation properties"@en ;
    rdfs:domain icodm:JavaConstraintAnnotation ;
    rdfs:range rdf:List .

icodm:semanticallyRefersTo
    a owl:ObjectProperty ;
    rdfs:label "semantically refers to"@en ;
    rdfs:comment "Links a selected annotation or condition property value to the RDF resources denoted by configured semantic terms."@en ;
    rdfs:domain icodm:CoProperty ;
    rdfs:range rdf:List .

woc:hasReturnType
    a owl:ObjectProperty ;
    rdfs:label "has return type"@en ;
    rdfs:comment "Links a method to the RDF resource representing its Java return type."@en ;
    rdfs:domain woc:Method ;
    rdfs:range owl:Class .

# Java conventions not covered in webofcode ontology

icodm:providesGetter a owl:ObjectProperty ;
    rdfs:label "java class has getter named"@en ;
    rdfs:comment "Links a java component with a java bean property name"@en ;
    rdfs:domain woc:Class ;
    rdfs:range xsd:string .

icodm:providesSetter a owl:ObjectProperty ;
    rdfs:label "java class has setter named"@en ;
    rdfs:comment "Links a java component with a java bean property name"@en ;
    rdfs:domain woc:Class ;
    rdfs:range xsd:string .

# Controlled Term Framework object properties

icodm:refersToTerm a owl:ObjectProperty ;
    rdfs:label "maps to controlled term"@en ;
    rdfs:comment "Links a code-level entity (like a Java parameter or method) to a structural controlled term concept."@en ;
    rdfs:domain icodm:CoProperty ;
    rdfs:range rdf:List .

icodm:suppliesInformation a owl:ObjectProperty ;
    rdfs:label "supplies information (string)"@en ;
    rdfs:comment "Links a java component entity to an information label."@en ;
    rdfs:domain woc:Class ;
    rdfs:range xsd:string.   

icodm:suppliesTerm a owl:ObjectProperty ;
    rdfs:label "supplies term (controlled term)"@en ;
    rdfs:comment "Links a java component entity to a structural controlled term concept."@en ;
    rdfs:domain woc:Class ;
    rdfs:range icodm:ControlledTerm.

icodm:consumesInformation a owl:ObjectProperty ;
    rdfs:label "consumes information (string)"@en ;
    rdfs:comment "Links a java component entity to an information label."@en ;
    rdfs:domain woc:Class ;
    rdfs:range xsd:string.

icodm:consumesTerm a owl:ObjectProperty ;
    rdfs:label "consumes term (controlled term)"@en ;
    rdfs:comment "Links a java component entity to a structural controlled term concept."@en ;
    rdfs:domain woc:Class ;
    rdfs:range icodm:ControlledTerm.      

# refmodule extension with contracts

icodm:methodCallContract
    a owl:ObjectProperty ;
    rdfs:label "contract on method call parameters"@en ;
    rdfs:comment "A condition set describing requirements on arguments to an API method."@en ;
    rdfs:domain woc:Method ;
    rdfs:range icodm:ApiConditionSet .

icodm:methodReturnContract
    a owl:ObjectProperty ;
    rdfs:label "contract on method return"@en ;
    rdfs:comment "A condition set describing guarantees or semantics of an API method's return value."@en ;
    rdfs:domain woc:Method ;
    rdfs:range icodm:ApiConditionSet .

icodm:callbackContract
    a owl:ObjectProperty ;
    rdfs:label "contract on callback parameters"@en ;
    rdfs:comment "A condition set describing requirements on arguments accepted by an API callback method."@en ;
    rdfs:domain woc:Method ;
    rdfs:range icodm:ApiConditionSet .

icodm:callbackReturnContract
    a owl:ObjectProperty ;
    rdfs:label "contract on callback return"@en ;
    rdfs:comment "A condition set describing guarantees or semantics of an API callback method's return value."@en ;
    rdfs:domain woc:Method ;
    rdfs:range icodm:ApiConditionSet .

icodm:typeUseContract
    a owl:ObjectProperty ;
    rdfs:label "contract on API type use"@en ;
    rdfs:comment "A condition set describing constraints or semantics attached to an API type."@en ;
    rdfs:domain owl:Class ;
    rdfs:range icodm:ApiConditionSet .

icodm:methodCallCondition
    a owl:ObjectProperty ;
    rdfs:label "condition on method call parameters"@en ;
    rdfs:comment "A condition describing requirements on arguments to an API method."@en ;
    rdfs:domain woc:Method ;
    rdfs:range icodm:ApiCondition .

icodm:methodReturnCondition
    a owl:ObjectProperty ;
    rdfs:label "condition on method return"@en ;
    rdfs:comment "A condition describing guarantees or semantics of an API method's return value."@en ;
    rdfs:domain woc:Method ;
    rdfs:range icodm:ApiCondition .

icodm:callbackCondition
    a owl:ObjectProperty ;
    rdfs:label "condition on callback parameters"@en ;
    rdfs:comment "A condition describing requirements on arguments accepted by an API callback method."@en ;
    rdfs:domain woc:Method ;
    rdfs:range icodm:ApiCondition .

icodm:callbackReturnCondition
    a owl:ObjectProperty ;
    rdfs:label "condition on callback return"@en ;
    rdfs:comment "A condition describing guarantees or semantics of an API callback method's return value."@en ;
    rdfs:domain woc:Method ;
    rdfs:range icodm:ApiCondition .

icodm:typeUseCondition
    a owl:ObjectProperty ;
    rdfs:label "condition on API type use"@en ;
    rdfs:comment "A condition describing constraints or semantics attached to an API type."@en ;
    rdfs:domain owl:Class ;
    rdfs:range icodm:ApiCondition .

icodm:includesCondition
    a owl:ObjectProperty ;
    rdfs:label "includes condition"@en ;
    rdfs:domain icodm:ApiConditionSet ;
    rdfs:range icodm:ApiCondition .

icodm:conditionProperties
    a owl:ObjectProperty ;
    rdfs:label "condition properties"@en ;
    rdfs:comment "An RDF list of icodm:ApiCoProperty resources. Each resource carries its property name in rdfs:label and its uninterpreted value in rdf:value."@en ;
    rdfs:domain icodm:ApiCondition ;
    rdfs:range rdf:List .


#################################################################
# Datatype properties
#################################################################

icodm:applBranch
    a owl:DatatypeProperty ;
    rdfs:label "applicable branch"@en ;
    rdfs:comment "A source-code branch to which a module, dependency, or API record applies."@en ;
    rdfs:range xsd:string .

icodm:applFor
    a owl:DatatypeProperty ;
    rdfs:label "applicable for"@en ;
    rdfs:comment "The library or API version represented by an API record."@en ;
    rdfs:range xsd:string .

icodm:targetVersion
    a owl:DatatypeProperty ;
    rdfs:label "target version"@en ;
    rdfs:comment "The resolved version of the target library dependency."@en ;
    rdfs:domain icodm:LibraryDependency ;
    rdfs:range xsd:string .

icodm:methodJavadoc
    a owl:DatatypeProperty ;
    rdfs:label "method Javadoc"@en ;
    rdfs:comment "The description text from a Java method or constructor Javadoc comment."@en ;
    rdfs:range xsd:string .

icodm:paramJavadoc
    a owl:DatatypeProperty ;
    rdfs:label "parameter Javadoc"@en ;
    rdfs:comment "The description text from a Java @param Javadoc tag."@en ;
    rdfs:domain woc:Parameter ;
    rdfs:range xsd:string .
