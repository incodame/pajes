<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.incodame.pajes</groupId>
	<artifactId>pajes</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>pajes</name>
	<description>Paragraph's Java Extraction System</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
      <!-- Spoon pour l'analyse du code source Java -->
      <dependency>
          <groupId>fr.inria.gforge.spoon</groupId>
          <artifactId>spoon-core</artifactId>
          <version>10.4.0</version> <!-- Adaptez selon la version Java cible -->
      </dependency>
      <!-- Apache Jena pour la création du graphe RDF -->
      <dependency>
          <groupId>org.apache.jena</groupId>
          <artifactId>apache-jena-libs</artifactId>
          <type>pom</type>
          <version>4.9.0</version>
      </dependency>
      <!-- Revapi SPI -->
      <dependency>
         <groupId>org.revapi</groupId>
         <artifactId>revapi-java-spi</artifactId>
         <version>0.25.1</version>
      </dependency>
      <dependency>
         <groupId>org.revapi</groupId>
         <artifactId>revapi-java</artifactId>
         <version>0.28.4</version>
      </dependency>
	  <!-- JUnit pour les tests -->
      <dependency>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter</artifactId>
          <version>5.10.3</version>
          <scope>test</scope>
      </dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.3</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<shadedArtifactAttached>false</shadedArtifactAttached>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>META-INF/*.MF</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>JavaPatchToRdf</mainClass>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
